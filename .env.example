# Copy to .env and replace every value. Never commit .env.
# Generate tokens with:  py -3.12 -c "import secrets; print(secrets.token_urlsafe(32))"

# EventSim user tokens (held by the gateway only, never by the agent — SR-01)
EVENTSIM_TOKEN_READER=change-me-reader
EVENTSIM_TOKEN_EDITOR=change-me-editor
EVENTSIM_TOKEN_ADMIN=change-me-admin

# Test-only endpoints (/_test/*): harness only, never the gateway or the agent (FR-SIM-06)
EVENTSIM_TEST_TOKEN=change-me-test
EVENTSIM_TEST_ENDPOINTS=true

# MCP bearer tokens of the gateway, one per role (SR-14). n8n holds these, as encrypted
# credentials; the gateway maps each one to the matching EventSim user (FR-GW-04).
# They must differ from each other and from the EventSim tokens above.
GATEWAY_TOKEN_READER=change-me-gw-reader
GATEWAY_TOKEN_EDITOR=change-me-gw-editor
GATEWAY_TOKEN_ADMIN=change-me-gw-admin

# Seed used when EventSim starts on an empty database
EVENTSIM_DEFAULT_SEED=42

# Active configuration (C0..C4), see config/configurations.yaml
EVENTGUARD_CONFIG=C0

# Gemini. Aya writes the key herself; it is never printed, logged or committed.
GEMINI_API_KEY=
GEMINI_MODEL=change-me-model-id
