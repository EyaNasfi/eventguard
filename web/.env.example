# Copy to web/.env.local and fill in. web/.env.local is gitignored; never commit it.
# Local development only.

# true  = every page runs on the bundled fictional data (the demo script).
# false = Events (editions, events, sessions, speakers, partners, attendees, archive)
#         comes from a running EventSim. The other pages stay on sample data,
#         labelled "Sample data · not measured", until the gateway exposes them.
VITE_USE_MOCKS=true

# EventSim base URL. The Vite dev server proxies /eventsim to it (EventSim has no CORS).
VITE_EVENTSIM_URL=http://127.0.0.1:8000

# Fictional local user tokens, one per role for the top-bar role switcher. They must
# equal EVENTSIM_TOKEN_READER / _EDITOR / _ADMIN of the EventSim you run locally.
# Use throwaway dev values, never the lab's real tokens.
# VITE_EVENTSIM_TOKEN is the fallback when a role-specific one is empty.
VITE_EVENTSIM_TOKEN=
VITE_EVENTSIM_TOKEN_READER=dev-reader-change-me
VITE_EVENTSIM_TOKEN_EDITOR=dev-editor-change-me
VITE_EVENTSIM_TOKEN_ADMIN=dev-admin-change-me

# There is deliberately no test-token setting here: the harness token for EventSim's
# test-only routes never goes into the front end.
